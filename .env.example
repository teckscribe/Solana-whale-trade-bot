# ==========================================
# 🐋 SOLANA WHALE TRACKER CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and configure your values.

# -------- System & APIs --------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
WALLET_PRIVATE_KEY=your_base58_solana_private_key_here

SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_api_key
GMGN_API_KEY=your_gmgn_api_key_here
GMGN_PRIVATE_KEY=your_gmgn_private_key_here

# -------- Trade Control --------
TRADE_MODE=PAPER
PAPER_BALANCE_USD=25.0
MAX_CONCURRENT_TRADES=5
TAKE_PROFIT_PCT=15.0
STOP_LOSS_PCT=-5.0
ALLOCATION_PCT=20.0
MIN_TRADE_SOL=0.02
LIVE_FEE_RESERVE_SOL=0.01
TIMEOUT_ENABLED=TRUE
TIMEOUT_MINUTES=30
MAX_RESUME_AGE_HOURS=2.0

# -------- Risk Caps --------
MAX_PORTFOLIO_EXPOSURE_PCT=100.0
MAX_POOL_SHARE_PCT=1.0
MAX_PRICE_IMPACT_PCT=3.0

# -------- Paper Trading Costs --------
PAPER_FEE_PCT_PER_LEG=1.0
ATA_RENT_SOL=0.00204
ATA_RENT_RECLAIMED=FALSE

# -------- GMGN Execution (Live Mode) --------
GMGN_PRIORITY_FEE=0.00001
GMGN_TIP_FEE=0.00001

# -------- Filters (Pre-Trade) --------
MOMENTUM_FILTER_ENABLED=FALSE
MAX_M5_PUMP_PCT=300.0
MIN_24H_VOLUME=50000.0
MIN_MARKET_CAP=50000.0
DISCOVERY_INTERVAL_MINUTES=10
MIN_WHALE_SOL_VOLUME=1

# -------- GMGN Whale Discovery --------
GMGN_DISCOVERY_ENABLED=TRUE
GMGN_MIN_WINRATE=60.0
GMGN_MIN_PNL_USD=5000.0
GMGN_MIN_TRADES=10
GMGN_MAX_TRADES_7D=100
GMGN_BANNED_TAGS=sniper,sandwich,bot

# -------- ML Engine --------
ML_ENGINE=FALSE
ML_CONFIDENCE=80.0

# -------- Web Server --------
WEB_PORT=8101
WEB_AUTH_TOKEN=your_secure_random_token_here
