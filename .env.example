# ==========================================
# 🐋 SOLANA WHALE TRACKER CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and configure your values.

# -------- System & APIs --------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=  # Optional: paste Discord channel webhook to mirror trade alerts
WALLET_PRIVATE_KEY=your_base58_solana_private_key_here

SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_api_key
GMGN_API_KEY=your_gmgn_api_key_here
GMGN_PRIVATE_KEY=your_gmgn_private_key_here
NANSEN_API_KEY=your_nansen_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here

# -------- Trade Control --------
TRADE_MODE=PAPER
PAPER_BALANCE_USD=50.0
MAX_CONCURRENT_TRADES=2
TAKE_PROFIT_PCT=20.0
STOP_LOSS_PCT=-10.0
ALLOCATION_PCT=15.0
MIN_TRADE_SOL=0.02
LIVE_FEE_RESERVE_SOL=0.01
TIMEOUT_ENABLED=TRUE
TIMEOUT_MINUTES=30
MAX_RESUME_AGE_HOURS=2.0
TRAILING_STOP_ENABLED=TRUE
TRAILING_STOP_ACTIVATION_PCT=8.0
TRAILING_STOP_CALLBACK_PCT=3.5

# -------- Risk & Cooldown Caps --------
MAX_PORTFOLIO_EXPOSURE_PCT=60.0
MAX_POOL_SHARE_PCT=1.0
MAX_PRICE_IMPACT_PCT=3.0
MAX_ROUND_TRIP_LOSS_PCT=5.0
MAX_DAILY_LOSS_PCT=5.0
MAX_SIGNAL_AGE_SECONDS=15.0
TOKEN_COOLDOWN_MINUTES=15
MAX_ENTRIES_PER_TOKEN_24H=2

# -------- Paper Trading Costs --------
PAPER_FEE_PCT_PER_LEG=1.0
ATA_RENT_SOL=0.00204
ATA_RENT_RECLAIMED=TRUE

# -------- GMGN Execution (Live Mode) --------
GMGN_PRIORITY_FEE=0.00001
GMGN_TIP_FEE=0.00001

# -------- Filters (Pre-Trade) --------
MOMENTUM_FILTER_ENABLED=TRUE
MAX_M5_PUMP_PCT=80.0
MIN_24H_VOLUME=25000.0
MIN_MARKET_CAP=35000.0
DISCOVERY_INTERVAL_MINUTES=10
MIN_WHALE_SOL_VOLUME=1.0

# -------- GMGN Whale Discovery --------
GMGN_DISCOVERY_ENABLED=TRUE
GMGN_MIN_WINRATE=45.0
GMGN_MIN_PNL_USD=500.0
GMGN_MIN_TRADES=5
GMGN_MAX_TRADES_7D=200
GMGN_MIN_SOL_BALANCE=1.0
GMGN_MIN_ROI_PCT=8.0
GMGN_MAX_FEE_TO_PROFIT_PCT=25.0
GMGN_BANNED_TAGS=sniper,mev,padre,banana,trojan,maestro,arbitrager,axiom,photon,bullx

# -------- Nansen Smart Money Discovery (optional premium channel) --------
NANSEN_DISCOVERY_ENABLED=TRUE
NANSEN_MIN_TRADE_USD=1000
NANSEN_SMART_MONEY_LABELS=30D Smart Trader,90D Smart Trader,180D Smart Trader
NANSEN_PROFILE_FALLBACK_ENABLED=TRUE
NANSEN_PROFILE_FALLBACK_LIMIT=5
NANSEN_PROFILE_CACHE_TTL_HOURS=6
GECKOTERMINAL_MAX_POOLS_PER_CHANNEL=5

# -------- ML Engine --------
ML_ENGINE=FALSE
ML_CONFIDENCE=80.0

# -------- Web Server --------
WEB_PORT=8101
WEB_AUTH_TOKEN=your_secure_random_token_here
